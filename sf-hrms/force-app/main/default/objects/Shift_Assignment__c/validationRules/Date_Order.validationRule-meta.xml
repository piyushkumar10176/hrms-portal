<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Effective_To__c)), Effective_From__c &gt; Effective_To__c)</errorConditionFormula>
    <errorMessage>Effective From cannot be after Effective To.</errorMessage>
</ValidationRule>
