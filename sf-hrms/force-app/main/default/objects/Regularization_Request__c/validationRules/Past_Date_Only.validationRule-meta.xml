<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Past_Date_Only</fullName>
    <active>true</active>
    <errorConditionFormula>Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Regularization can only be requested for past dates.</errorMessage>
</ValidationRule>
