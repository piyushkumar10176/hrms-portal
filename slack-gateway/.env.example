# Salesforce. The gateway talks to Salesforce directly; it never calls the portal.
# Refresh token flow is preferred and is what the portal uses.
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=

# Fallback if no refresh token is available
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional, and not needed today. Leave it blank.
#
# On an Enterprise Grid org-wide install, Slack refuses CHANNEL-scoped calls
# without knowing which workspace is meant, which is the team_access_not_granted
# error. Calls aimed at a person rather than a channel, which is all this gateway
# makes, work without it. Tested: views.publish succeeds with no team_id set.
#
# If a channel post is ever added here, the value is the WORKSPACE id starting
# with T, not the enterprise id starting with E. For this org that is
# T0BV8DT6LKG, the same value Salesforce already uses.
SLACK_TEAM_ID=

# Where invitation and password links point. This stays the portal's address
# while the portal exists, because that is where somebody sets a password.
NEXTAUTH_URL=https://hrms-portal-cyan.vercel.app

# Biometric device shared secret. The endpoint returns 503 until this is set.
BIOMETRIC_WEBHOOK_SECRET=

# Email. Leave unset and nothing is sent, which is deliberate.
EMAIL_DRIVER=
RESEND_API_KEY=
EMAIL_FROM=
