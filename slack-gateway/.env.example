# Salesforce. The gateway talks to Salesforce directly; it never calls the portal.
# Refresh token flow is preferred and is what the portal uses.
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=

# Fallback if no refresh token is available
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Workspace id. Required on an Enterprise Grid org-wide install, where Slack
# refuses workspace-scoped calls without it.
SLACK_TEAM_ID=

# Where invitation and password links point. This stays the portal's address
# while the portal exists, because that is where somebody sets a password.
NEXTAUTH_URL=https://hrms-portal-cyan.vercel.app

# Biometric device shared secret. The endpoint returns 503 until this is set.
BIOMETRIC_WEBHOOK_SECRET=

# Email. Leave unset and nothing is sent, which is deliberate.
EMAIL_DRIVER=
RESEND_API_KEY=
EMAIL_FROM=
